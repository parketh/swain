# These provider env vars are for standalone package smoke tests and non-TUI
# callers that intentionally exercise provider env fallbacks. The interactive
# TUI stores credentials via `/connect` in the global Swain auth file
# (${XDG_CONFIG_HOME:-~/.config}/swain/auth.json); remove real keys from a
# local .env after connecting there.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
OPENAI_CODEX_ACCESS_TOKEN=
ZAI_API_KEY=

# TODO: refactor to use MCP for WebSearch tool as it offers API key-free access
EXA_API_KEY=

# Evals
# Swain currently only ships x86 linux binaries, so this is needed to specify the correct target
# on Apple Silicon Macs
DOCKER_DEFAULT_PLATFORM= # e.g. linux/amd64
SWAIN_EVAL_VERSION= # e.g. 0.1.0
SWAIN_EVAL_MODEL= # e.g. anthropic/claude-opus-4-8
SWAIN_EVAL_VARIANT= # optional, e.g. high
