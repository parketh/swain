{
  "name": "@swain/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "swain": "./bin/swain.tsx"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@effect/platform": "0.97.0",
    "@effect/platform-bun": "0.91.0",
    "@swain/core": "workspace:*",
    "@swain/llms": "workspace:*",
    "effect": "3.22.0",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "bun test test --path-ignore-patterns='**/live/**'",
    "test:live": "bun --env-file=../../.env test test/live",
    "build:release": "bun run scripts/build-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2"
  }
}
